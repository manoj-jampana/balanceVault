NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Neon pooled URL for application queries
DATABASE_URL="postgresql://RUNTIME_USER:RUNTIME_PASSWORD@YOUR-NEON-POOLER-HOST/balancevault_db?sslmode=require"
# Neon direct URL for Prisma migrations
DIRECT_URL="postgresql://MIGRATOR_USER:MIGRATOR_PASSWORD@YOUR-NEON-DIRECT-HOST/balancevault_db?sslmode=require"
# Separate INSERT-only database role for audit events
AUDIT_DATABASE_URL="postgresql://AUDIT_WRITER:AUDIT_PASSWORD@YOUR-NEON-DIRECT-HOST/balancevault_db?sslmode=require"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
# Redis TCP/TLS URL (local Redis or hosted Redis)
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
